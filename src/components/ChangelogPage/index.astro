---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { downloadPath, loadReleases, releaseId } from '../../data/releases.js';
import { assetHref, translationsFor } from '../../i18n/translations.js';
import './changelog.css';

const { locale } = Astro.props;
const translations = translationsFor(locale);
const releases = await loadReleases();
const latest = releases[0];
const dateFormat = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<SiteLayout page="changelog" locale={locale} translations={translations}>
<main id="main">
  <section class="page" aria-labelledby="page-title">
    <div class="shell">
      <h1 id="page-title" class="page__title">{translations.common.changelog}</h1>
      <p class="lede">{translations.changelog.intro}</p>
      {releases.length ? (
        <ol class="log" role="list">
          {releases.map((release) => (
            <li class="log__item" id={releaseId(release.version)}>
              <div class="log__meta">
                <div class="log__heading">
                  <h2 class="log__ver"><a href={`#${releaseId(release.version)}`}>{`v${release.version}`}</a></h2>
                  {release === latest && (
                    <a class="log__download" href={assetHref(downloadPath(release))} download aria-label={`${translations.common.download} v${release.version}`}>
                      {translations.common.download}
                    </a>
                  )}
                </div>
                <time class="log__date" datetime={release.published_at}>{dateFormat.format(new Date(release.published_at))}</time>
              </div>
              <div class="log__content">
                <ul class="log__notes">{release.notes[locale].map((note) => <li>{note}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      ) : <p class="log__empty">{translations.changelog.empty}</p>}
    </div>
  </section>
</main>
</SiteLayout>
