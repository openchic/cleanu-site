{
  "name": "cleanu-site",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.development.local ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
